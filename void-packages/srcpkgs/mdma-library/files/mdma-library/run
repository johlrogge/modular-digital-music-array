#!/bin/sh
exec 2>&1
sv check mdma-acid || exit 1
sleep 1
mkdir -p /music/inbox /music/blobs /music/cover-art /metadata /run/mdma
chown mdma:mdma /music/inbox /music/blobs /music/cover-art /run/mdma 2>/dev/null || true
export RUST_LOG=info
exec chpst -u mdma /usr/bin/mdma-library \
    --music-dir /music \
    --metadata-dir /metadata \
    --socket ipc:///run/mdma/library.sock \
    --acid-socket ipc:///run/mdma/acid.sock \
    --acid-events-socket ipc:///run/mdma/acid-events.sock
