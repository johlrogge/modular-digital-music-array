# Template file for mdma-acid package
pkgname=mdma-acid
version=0.9.0
revision=2
archs="aarch64"
build_style=cargo
hostmakedepends="cargo"
makedepends="rust-std"
short_desc="MDMA ACID metadata service"
maintainer="Joakim Ohlrogge <joakim.ohlrogge@agical.se>"
license="MIT"
homepage="https://github.com/johlrogge/modular-digital-music-array"

distfiles="https://github.com/johlrogge/modular-digital-music-array/archive/v${version}.tar.gz"
checksum="SKIP"

do_build() {
    cargo build --release --bin mdma-acid --target aarch64-unknown-linux-gnu
}

do_install() {
    vbin target/aarch64-unknown-linux-gnu/release/mdma-acid
    vsv mdma-acid
}
