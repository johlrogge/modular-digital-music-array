#!/bin/sh
# INSTALL script for mdma-acid package
# $1 = action (pre/post), $2 = pkgname, $3 = version, $4 = "yes" if upgrade
case "$1" in
post)
    # Create log directory for svlogd
    mkdir -p /var/log/mdma-acid

    # Enable service on first install
    if [ ! -d /var/service ]; then
        mkdir -p /var/service
    fi
    if [ ! -e /var/service/mdma-acid ]; then
        ln -sf /etc/sv/mdma-acid /var/service/mdma-acid
        echo "mdma-acid service enabled"
    fi

    # On upgrade, restart only if the service is currently running
    if [ "$4" = "yes" ]; then
        if sv check mdma-acid >/dev/null 2>&1; then
            sv restart mdma-acid
            echo "mdma-acid service restarted"
        fi
    fi
    ;;
esac
