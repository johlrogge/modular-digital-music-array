#!/bin/sh
# INSTALL script for mdma-admin package
# $1 = action (pre/post), $2 = pkgname, $3 = version, $4 = "yes" if upgrade
case "$1" in
post)
    # Create log directory for svlogd
    mkdir -p /var/log/mdma-admin

    # Enable service on first install
    if [ ! -d /var/service ]; then
        mkdir -p /var/service
    fi
    if [ ! -e /var/service/mdma-admin ]; then
        if ln -sfn /etc/sv/mdma-admin /var/service/mdma-admin; then
            echo "mdma-admin service enabled"
        fi
    fi

    # Enable acpid (power key) and mdma-klog (persistent kernel log), also on
    # upgrades. Never restarted here: restarting mdma-klog replays the ring
    # buffer and would duplicate the log.
    # To disable these services lastingly, touch /etc/sv/<svc>/down: upgrades
    # re-link a /var/service link that was removed.
    for svc in acpid mdma-klog; do
        if [ -d "/etc/sv/$svc" ] && [ ! -e "/var/service/$svc" ] && [ ! -L "/var/service/$svc" ]; then
            if ln -sfn "/etc/sv/$svc" "/var/service/$svc"; then
                echo "$svc service enabled"
            fi
        fi
    done

    # On upgrade, restart only if the service is currently running
    if [ "$4" = "yes" ]; then
        if sv check mdma-admin >/dev/null 2>&1; then
            sv restart mdma-admin
            echo "mdma-admin service restarted"
        fi
    fi
    ;;
esac
