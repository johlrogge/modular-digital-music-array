# Template file for mdma-playback package
pkgname=mdma-playback
version=0.4.0
revision=1
archs="aarch64"
build_style=cargo
hostmakedepends="cargo"
makedepends="rust-std"
depends="pipewire wireplumber libspa-alsa alsa-pipewire"
short_desc="MDMA audio playback server"
maintainer="Joakim Ohlrogge <joakim.ohlrogge@agical.se>"
license="MIT"
homepage="https://github.com/johlrogge/modular-digital-music-array"

distfiles="https://github.com/johlrogge/modular-digital-music-array/archive/v${version}.tar.gz"
checksum="SKIP"

do_build() {
    cargo build --release --bin mdma-playback --target aarch64-unknown-linux-gnu
}

do_install() {
    vbin target/aarch64-unknown-linux-gnu/release/mdma-playback
    vsv mdma-playback
}
