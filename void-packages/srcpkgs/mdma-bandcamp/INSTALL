#!/bin/sh
# INSTALL script for mdma-bandcamp package
# $1 = action (pre/post), $2 = pkgname, $3 = version, $4 = "yes" if upgrade
case "$1" in
post)
    # Create log directory for svlogd
    mkdir -p /var/log/mdma-bandcamp

    mkdir -p /run/mdma/sources /var/lib/mdma
    mkdir -p /music/downloads /music/inbox
    mkdir -p /etc/mdma

    # Install default conf if not already present
    if [ ! -f /etc/mdma/bandcamp.conf ]; then
        cp /etc/mdma/bandcamp.conf.example /etc/mdma/bandcamp.conf
        echo "mdma-bandcamp: installed default conf at /etc/mdma/bandcamp.conf"
        echo "  Edit MDMA_BANDCAMP_USERNAME to match your Bandcamp account"
    fi

    # Create mdma user if doesn't exist
    if ! id mdma >/dev/null 2>&1; then
        useradd -r -s /sbin/nologin -d /music -c "MDMA Service User" mdma || true
    fi

    # Set ownership
    chown -R mdma:mdma /music /run/mdma /var/lib/mdma 2>/dev/null || true

    # Enable service on first install
    if [ ! -d /var/service ]; then
        mkdir -p /var/service
    fi
    if [ ! -e /var/service/mdma-bandcamp ]; then
        ln -sf /etc/sv/mdma-bandcamp /var/service/mdma-bandcamp
        echo "mdma-bandcamp service enabled"
    fi

    # On upgrade, restart only if the service is currently running
    if [ "$4" = "yes" ]; then
        if sv check mdma-bandcamp >/dev/null 2>&1; then
            sv restart mdma-bandcamp
            echo "mdma-bandcamp service restarted"
        fi
    fi
    ;;
esac
