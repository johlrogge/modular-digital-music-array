#!/bin/sh
exec 2>&1

CONF=/etc/mdma/bandcamp.conf
if [ ! -f "$CONF" ]; then
    echo "ERROR: config file $CONF not found"
    exit 1
fi

. "$CONF"

if [ -z "$MDMA_BANDCAMP_USERNAME" ]; then
    echo "ERROR: MDMA_BANDCAMP_USERNAME is not set in $CONF"
    exit 1
fi

mkdir -p /run/mdma/sources /var/lib/mdma
export RUST_LOG=info
exec chpst -u mdma /usr/bin/mdma-bandcamp \
    --cookies /etc/mdma/bandcamp-cookies.json \
    --downloads-dir /music/downloads \
    --inbox-dir /music/inbox \
    --cache /var/lib/mdma/bandcamp.cache \
    --socket ipc:///run/mdma/sources/bandcamp.sock \
    --library-socket ipc:///run/mdma/library.sock \
    --username "$MDMA_BANDCAMP_USERNAME"
