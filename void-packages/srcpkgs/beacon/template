# Template file for beacon package
pkgname=beacon
version=0.28.2
revision=2
archs="aarch64"
build_style=cargo
hostmakedepends="cargo"
makedepends="rust-std"
depends="avahi dbus wpa_supplicant dhcpcd iw wireless-regdb"
conf_files="/etc/xbps.d/10-mdma.conf"
short_desc="MDMA provisioning beacon"
maintainer="Joakim Ohlrogge <joakim.ohlrogge@agical.se>"
license="MIT"
homepage="https://github.com/johlrogge/modular-digital-music-array"

# Set this to your actual git tag/commit
distfiles="https://github.com/johlrogge/modular-digital-music-array/archive/v${version}.tar.gz"
checksum="SKIP"  # For development; use real checksum for production

# Build only the beacon binary
do_build() {
    cargo build --release --bin beacon --target aarch64-unknown-linux-gnu
}

do_install() {
    # Install beacon binary
    vbin target/aarch64-unknown-linux-gnu/release/beacon
    
    # Install runit service
    vsv beacon

    # Wifi service for the beacon (credentials come from the installed
    # system, copied to tmpfs). The 'down' file keeps it from starting at
    # boot; the beacon runs 'sv up beacon-wifi' when needed. vsv copies the
    # whole files/beacon-wifi directory, so 'down' ships with it.
    vsv beacon-wifi

    # Install MDMA package repo config so the device can self-update
    vinstall ${FILESDIR}/10-mdma.conf 644 etc/xbps.d
}

post_install() {
    # The service will be enabled by bootstrap script
    :
}
