# Package metadata for beacon.
#
# This is NOT an xbps-src build template: nothing here builds anything. The
# binary is cross-compiled by scripts/ci/ and the package is assembled by
# scripts/package/create-service-package.sh, which sources this file for
# depends, short_desc, conf_files and revision. The package version comes from
# Cargo.toml; `version=` below is only checked against it by
# scripts/ci/verify-packages.sh (bump it together with Cargo.toml).
#
# Also part of the package (see the script header for the full contract):
#   INSTALL, REMOVE   package scripts, copied verbatim
#   files/<d>/        runit service dirs (those with a `run`) -> /etc/sv/<d>/
#   files/rootfs/**   copied verbatim into the package root
pkgname=beacon
version=0.33.0
revision=1
archs="aarch64"
depends="avahi dbus wpa_supplicant dhcpcd iw wireless-regdb acpid"
conf_files="/etc/xbps.d/10-mdma.conf"
short_desc="MDMA provisioning beacon"
