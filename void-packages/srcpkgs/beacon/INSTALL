#!/bin/sh
# INSTALL script for beacon package
# $1 = action (pre/post), $2 = pkgname, $3 = version, $4 = "yes" if upgrade
case "$1" in
post)
    # Create log directory for svlogd
    mkdir -p /var/log/beacon /var/log/beacon-wifi

    # beacon runs as root (the service script uses chpst -u root), so no
    # user/group setup is needed here.

    # Enable service on first install
    if [ ! -d /var/service ]; then
        mkdir -p /var/service
    fi
    if [ ! -e /var/service/beacon ]; then
        ln -sfn /etc/sv/beacon /var/service/beacon
        echo "beacon service enabled"
    fi

    # Enable beacon-wifi (ships a 'down' file, so it stays stopped until the
    # beacon runs 'sv up beacon-wifi'; never started or restarted here)
    if [ ! -e /var/service/beacon-wifi ]; then
        ln -sfn /etc/sv/beacon-wifi /var/service/beacon-wifi
        echo "beacon-wifi service enabled"
    fi

    # dhcpcd manages wlan0 as well as ethernet; skip if any dhcpcd* service
    # (e.g. dhcpcd-eth0) is already enabled, two instances would fight
    found=
    for s in /var/service/dhcpcd*; do
        if [ -e "$s" ] || [ -L "$s" ]; then found=1; fi
    done
    if [ -z "$found" ]; then
        ln -sfn /etc/sv/dhcpcd /var/service/dhcpcd
        echo "dhcpcd service enabled"
    fi

    # On upgrade, restart only if the service is currently running
    if [ "$4" = "yes" ]; then
        if sv check beacon >/dev/null 2>&1; then
            sv restart beacon
            echo "beacon service restarted"
        fi
    fi
    ;;
esac
