#!/bin/sh
# INSTALL script for mdma-console package
# $1 = action (pre/post), $2 = pkgname, $3 = version, $4 = "yes" if upgrade
case "$1" in
post)
    # Create log directory for svlogd
    mkdir -p /var/log/mdma-console

    # CAP_NET_BIND_SERVICE is applied in the runit run script (before chpst drops
    # privileges to the 'mdma' user). No capability work needed here.

    # Enable service on first install
    if [ ! -d /var/service ]; then
        mkdir -p /var/service
    fi
    if [ ! -e /var/service/mdma-console ]; then
        ln -sf /etc/sv/mdma-console /var/service/mdma-console
        echo "mdma-console service enabled"
    fi

    # On upgrade, restart only if the service is currently running
    if [ "$4" = "yes" ]; then
        if sv check mdma-console >/dev/null 2>&1; then
            sv restart mdma-console
            echo "mdma-console service restarted"
        fi
    fi
    ;;
esac
