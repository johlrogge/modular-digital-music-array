# Template file for mdma-console package
pkgname=mdma-console
version=0.16.2
revision=1
archs="aarch64"
build_style=cargo
hostmakedepends="cargo"
makedepends="rust-std"
depends="ffmpeg"
short_desc="MDMA web console"
maintainer="Joakim Ohlrogge <joakim.ohlrogge@agical.se>"
license="MIT"
homepage="https://github.com/johlrogge/modular-digital-music-array"

distfiles="https://github.com/johlrogge/modular-digital-music-array/archive/v${version}.tar.gz"
checksum="SKIP"

do_build() {
    cargo build --release --bin mdma-console --target aarch64-unknown-linux-gnu
}

do_install() {
    vbin target/aarch64-unknown-linux-gnu/release/mdma-console
    vsv mdma-console
}
