#!/bin/sh
# INSTALL script for mdma-console
# Runs on the target system after package installation/upgrade.
#
# mdma-console binds to port 80 but runs as the unprivileged 'mdma' user.
# CAP_NET_BIND_SERVICE allows it to bind to privileged ports without root.

case "${ACTION}" in
post)
    # Use absolute path: xbps runs INSTALL scripts with a minimal PATH that
    # may not include /usr/sbin where setcap lives on Void Linux.
    if [ -x /usr/sbin/setcap ]; then
        /usr/sbin/setcap 'cap_net_bind_service=+ep' /usr/bin/mdma-console
    fi
    ;;
esac
